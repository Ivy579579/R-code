#控制语句switch

cond <- 2   #判断值为整数，按顺序匹配
a <- switch(cond,
           'AAA',
           'BBB',
           'CCC')

cond <- 'A' #判断值为字符
a <- switch(cond, 
            'A' = 'AAA',
            'B' = 'BBB',
            'C' = 'CCC')

cond <- 'B' #判断值为字符
a <- switch(cond, 
            A = 'AAA',
            B = 'BBB',
            C = 'CCC')

cond <- 'G' #判断值为字符
a <- switch(cond, 
            A = 'AAA',
            B = 'BBB',
            C = 'CCC',
            'DDD') # 没有对应值时的默认值

# 如果判断值为数字，但不按照顺序匹配，怎么做？

cond <- 4 #判断值为数字
a <- switch(as.character(cond), 
            '2' = 'AAA',
            '3' = 'BBB',
            '1' = 'CCC',
            'DDD') 


#匹配一组语句
cond <- 5 
a <- switch(as.character(cond),
            ' ' = {
              b <- 'AAA'
              c <- 'ABC'
            },
            '3' = {
              b <- 'BBB'
              c <- 'BCD'
            },
            '1' = {
              b <- 'CCC'
              c <- 'CDF'
            },
            {
              b <- 'DDD'
              c <- 'FFF'
            })


