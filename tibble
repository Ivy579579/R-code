#tibble(data.frame的新发展)
library('tibble')
data(iris)
iris
head(iris, 9)
tail(iris)
class(iris)
str(iris)

as_tibble(iris)

tb1 <- tibble(x = 1:5, y = sample(10, 5), z = x^2 + y*3);tb1

tribble(
  ~x,~y,~z,
 #/-/-/-/
  1,2,3,
  4,5,6
)

a <- tibble(name = character(0), score = numeric(0))
class(a)
a
edit(a) #出现编辑器进行编辑
a
a <- edit(a) #要及时赋值
fix(a) #等价于上面的edit()与赋值，并直接保存
a

mydata1 <- '
name gender score
John M 80
Kate F 87
'
b <- read.table(text = mydata1, header = T)
b

mydata2 <- '
name,gender,score
张三,男,80
李红,女,87
'
c <- read.table(text = mydata2, header = T, sep = ',')
c

class(a)
class(b)
class(c) 
##a,b,c都是数据框形式
##需要通过转换才能构建tibble
as_tibble(a)
as_tibble(b)

##tibble与data.frame的区别
###1.tibble构建时就可直接使用新变量
data.frame(x = 1:5, y = sample(10, 5), z = x^2 + y*3) #不允许

###2.tibble中可以直接容纳list结构
data.frame(x = 1:3, y = list(1,2,3)) #跟预期不同
tibble(x = 1:3, y = list(1,2,3)) #跟预期同
View(tibble(x = 1:3, y = list(1,2,3)))# 与View(tibble(x = 1:3, y = c(1,2,3)))显示相同，内在结构不同
tibble(x = 1:3, y = list(1,2,3), z = x+y) #不能相加
tibble(x = 1:3, y = c(1,2,3), z = x+y) # 可以相加
####拓展
tb2 <- tibble(x = 1:4, y = list(1:10, list(1:20, 4), matrix(1:20,4), tb1));tb2
View(tb2)
#####提取matrix
tb2$y[[3]]
apply(tb2$y[[3]], 2, mean)

####对list内部元素命名
tb3 <- tibble(x = 1:4, y = list(a = 1:10, b = list(1:20, 4), c = matrix(1:20,4), d = tb1));tb3

##将前述课程的models及l4放置到


######提取matrix
tb3$y$c
####总结：除了要求各列元素相同之外，tibble拥有与list相同的兼容性

###3.tibble不会直接将字符型的变量转化为因子；R4.0.0后的data.frame也采用了这个特征

###4.tibble避免了df[,1:2]为data.frame类型，df[,1]为向量类型的不确定性
data(iris)
class(iris[,1:2])
class(iris[,1])

iris <- as_tibble(iris)
class(iris[,1:2])
class(iris[,1])

###5.tibble构建时对循环的限定更严格
data.frame(x = 1:2, y = 1:10) #自动拓展维度
tibble(x = 1:2, y = 1:10) #不允许
tibble(x = 1, y = 1:10) #这种情况是允许的


