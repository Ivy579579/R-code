##问题：找出flights中最受欢迎10个目的地的所有航班信息
#第1步：找出10个目的地
flights |> count(dest, sort = T) |> slice(1:10)
##或者
flights |> count(dest) |> 
  slice_max(order_by = n, n = 10)
    ##或者最不受欢迎10个目的地
    flights |> count(dest) |> 
      slice_min(n = 10, order_by = n) 
    flights |> count(dest) |> 
      slice_min(prop = 0.1, order_by = n) #prop表示比例
#第2步：筛选航班信息
flights |> semi_join(flights |> 
                       count(dest, sort = T) |>
                       slice(1:10))


# 集合运算及追加、合并

## 集合运算
set.seed(100)
ssm <- diamonds |> slice_sample(n = 10)
ssm
(ssm1 <- ssm |> slice_head(n = 7))
(ssm2 <- ssm |> slice_tail(n = 6))
setdiff(ssm1, ssm2) #差集
ssm1 |> intersect(ssm2) #交集
ssm1 |> union(ssm2) #并集,会去重
ssm1 |> union_all(ssm2) #保留重复记录

## 追加与合并

#行名转换
ssm |> rowid_to_column()
ssm |> rownames_to_column()
ssm |> rownames_to_column(var = 'rn') -> ssm1; ssm1
ssm2 <- ssm1 |> column_to_rownames(var = 'rn'); ssm2
#信息跟之前的ssm一样，但是行号由灰色变成黑色
#作用在哪？
ssm |> slice_sample(n = 5)
ssm1 |> slice_sample(n = 5)
ssm2 |> slice_sample(n = 5)
#可追踪抽样结果

#可赋字符串给行号，但保证唯一性
ssm |> 
  mutate(sp = sample(LETTERS, 10)) |> 
  column_to_rownames(var = 'sp')

#追加/合并行、列
(sxyz <- ssm |> slice(1:5) |> select(x:z))
#列----
#add_column追加列
sxyz |> add_column(xyz = 1) #默认排在后面
sxyz |> add_column(xyz = 1:5, .before = 2) #第2列前
sxyz |> add_column(xyz = 1:5, .after = 2) #第2列后

#bind_cols合并列
#1. 加向量（变量）
sxyz |> bind_cols(up = 1:5, down = 5:1)

#2.加数据框
w <- c(1,7,8,9,3)
bind_cols(sxyz, tibble(w)) #dplyr中的函数
add_column(sxyz, tibble(w)) #tibble中的函数

#小结：bind_cols与add_column功能用法几乎一致

#行----
#add_row追加行
sxyz |> add_row(x = 1, y = 2, z = 3) 
sxyz |> add_row(x = c(1:2), y = c(2:3), z = c(3:4)) 
sxyz |> add_row(x = c(1:2), y = c(2:3), z = c(3:4), .before = 2) #第2行前
sxyz |> add_row(x = c(1:2), y = c(2:3), z = c(3:4), .after = 2) #第2行后

#bind_rows合并行
#1. 加向量（变量）
bind_rows(sxyz, c(x = 1, y = 2, z =3))
bind_rows(sxyz, x = 1, y = 2, z = 3) #会报错
add_row(sxyz, x = 1, y = 2, z = 3) #正确
##bind_rows按组合并，add_row按变量追加

bind_rows(
  c(a = 1, b = 2),
  tibble(a = 4:6, b = 7:9),
  c(a = 10, b = 20)
)

add_row(
  c(a = 1, b = 2),
  tibble(a = 4:6, b = 7:9),
  c(a = 10, b = 20)
) #会报错

add_row(
  tibble(a = 4:6, b = 7:9), #第一个参数需是数据框
  a = c(1,10), b = c(2,20)
) #修正

#2.加数据框
a <- tibble(y = 1, z =2, x = 3)
add_row(sxyz, a)
bind_rows(sxyz, a)

#add_row与bind_rows按向量（变量）追加时用法有差异，按数据框追加用法一致
#总结：add_*与bind_*函数功能一致，但bind_*更高效，add_*选项更多。

