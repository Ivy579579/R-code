# 关系连接

##键的概念
#主键：唯一标记所在数据表观测记录的键
#外键：唯一标记另一数据表观测记录的键
#判断方法
airlines |> count(carrier) |> filter(n > 1) #注意n是count计算的默认变量
airports |> count(faa, name = 'count') |> filter(count > 1)
##flights有没有主键？
flights |> summarise(across(.cols = everything(), 
                             .fns = ~ n_distinct(.))) |> glimpse()
flights |> nrow()
##主键并非单一变量，也可以是多变量的组合
flights |> count(across(1:11)) |> filter(n > 1) |> glimpse() #前11个变量可联合组成主键
#主键的变量太多，就失去应用价值了，可以设计一个主键
flights |> rownames_to_column() 

# 关系连接——合并连接（多表信息组合）

x <- tribble(
  ~key, ~char_x, ~num_x,
  1,    'x1',     10,
  2,    'x2',     20,
  3,    'x3',     30
)
x
y <- tribble(
  ~key, ~char_y, ~num_y,
  1,    'y1',     100,
  3,    'y3',     300,
  4,    'y4',     400
)
y

inner_join(x, y) #内连接，交运算
left_join(x, y) #左连接
right_join(x, y) #右连接
full_join(x, y) #全连接

right_join(y, x) #相当于 left_join(x, y)。
#上述inner_join(v1,v2)等4个函数，行列排列上都是以v1变量的结构为主。

#变化1：匹配字段名不同的情形
(X1 <- x |> rename(key_x = key))
(Y1 <- y |> rename(key_y = key))
X1 |> inner_join(Y1) #找不到共同的变量，报错
X1 |> inner_join(Y1, by = c('key_x' = 'key_y')) 
  #by中变量的顺序要跟数据集引用顺序一致，多个变量可在c()中依次追加

#变化2：相同字段的后缀处理情形
X2 <- rename_with(x,
                  .fn = ~ sub(x = ., pattern = '_x', replacement = ''),
                  .cols = everything()) #.cols = everything()可省
X2
Y2 <- rename_with(y,
                  .fn = ~ sub(x = ., pattern = '_y', replacement = ''),
                  .cols = everything()) 
Y2
X2 |> inner_join(Y2) #没有匹配的结果，原因是默认情况下按照所有共同的字段来匹配
X2 |> inner_join(Y2, by = 'key') #同名字段的后缀处理
X2 |> inner_join(Y2, by = 'key', suffix = c('_1','_2'))

#变化3: 键值重复情形
(X3 <- bind_rows(x, tibble(key = 3, char_x = 'x3.1', num_x = 31)))
(Y3 <- bind_rows(y, tibble(key = 3, char_y = 'y3.1', num_y = 310)))

X3 |> inner_join(Y3, by = 'key') #完成了笛卡尔积的运算
X3 |> left_join(Y3, by = 'key') 
##有提示信息，若静默该信息，在函数内加入relationship ="many-to-many"
X3 |> inner_join(Y3, by = 'key', relationship ="many-to-many")
  ## relationship ="one-to-one"  两边key值要唯一
  ## relationship ="one-to-many" 左边key值要唯一
  ## relationship ="many-to-one" 右边key值要唯一
  ## 以下语句都报错：
      X3 |> inner_join(Y3, by = 'key', relationship ="one-to-one")
      X3 |> inner_join(Y3, by = 'key', relationship ="one-to-many")
      X3 |> inner_join(Y3, by = 'key', relationship ="many-to-one")


#实例应用
flights |> left_join(airlines) |> View()
flights |> left_join(weather) 
flights |> left_join(planes) #注意两个表中的year不是一个意思，所以指定一下
flights |> left_join(planes, by = 'tailnum')
flights |> left_join(airports, by = c('origin' = 'faa')) #追加出发机场的信息
flights |> left_join(airports, by = c('dest' = 'faa')) #追加终点机场的信息
##注意到一个特点：实际操作中，经常用的是left_join，而且，左边一般是放置主要的数据集（有重复记录，提供外键），如果用right_join，正好相反。
setequal(flights |> left_join(airports, by = c('origin' = 'faa')),
         airports |> right_join(flights, by = c('faa' = 'origin')) |> 
           rename(origin = faa)) #TRUE

