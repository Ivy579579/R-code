## 对于数组
set.seed(1)
(a <- array(sample(1:20,size = 24, r = T), c(3,4,2)))
apply(a, 1, mean) # 对所有的第一行进行计算
mean(a[1,,])
mean(a[3,,])
apply(a, 2, mean) # 对所有的第一列进行计算
mean(a[,1,])
apply(a, 3, mean) # 对各组矩阵求平均值
mean(a[,,1])
mean(a) # 对全体

### 更复杂的情况
apply(a, MARGIN = c(1,2), mean) #按行、列切
apply(a, MARGIN = c(2,1), mean) #按列、行切；跟上面的结果相同，输出的顺序不同
apply(a, MARGIN = c(1,3), mean) #按行、组切
### 其他的2维组合大家去尝试
apply(a,c(1,2,3),mean) #不变
apply(a,c(3,2,1),mean) #重排信息，先切组（形成2行），再切列（形成4列），再切行（形成2组）
#归纳：对于聚合函数而言，MARGIN的参数选用的行列组维度，决定了输出的行列组维度。

