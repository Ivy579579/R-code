##next与break的使用
for(i in 1:10){
  print(i)
}

for(i in 1:10){
  if(i == 4) next #跳到下一个循环
  print(i)
}

for(i in 1:10){
  if(i == 4) break  #结束循环
  print(i)
}

#while循环

i <- 1 #1.确定循环变量初始值
while(i < 10){
  cat(i, '的平方：', i^2, '\n')
  i <- i + 1 #2.更新循环变量
}

##在程序中跳出
i <- 1
while(T){
  cat(i, '的平方：', i^2, '\n')
  i <- i + 1
  if(i >= 10) break
}

##跳过4
i <- 1
while(T){
  if(i == 4){
    i <- i + 1
    next
  }
  cat(i, '的平方：', i^2, '\n')
  i <- i + 1
  if(i >= 10) break
}

while(T) print(1) #死循环，会一直进行直到内存占满，可用stop按钮手动停止


