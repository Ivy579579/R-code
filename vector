### 多参数情形，需整理成list或data.frame
### rnorm(n,mean, sd) 一次性发送多种参数的随机数
###情形1
args <- list(n = c(10,20,30),
             sd = c(100, 50, 10),
             mean = c(-10, 0, 10))

pmap(args, rnorm)

###情形2
args1 <- list(n1 = c(10,20,30),
             sd = c(100, 50, 10),
             mean = c(-10, 0, 10))

pmap(args1, rnorm) #不可以
pmap(args1, ~rnorm(n = ..1, mean = ..3, sd = ..2))
pmap(args1, ~rnorm(..1, ..3, ..2))

###情形3
args2 <- list(n = c(10,20,30),
              sd = c(100, 50, 10),
              mean = c(-10, 0, 10),
              var = 1000) #多一个量
pmap(args2, \(n, sd, mean)
     rnorm(n = n, sd = sd, mean = mean)) #不可以

pmap(args2, \(n, sd, mean,...)
     rnorm(n = n, sd = sd, mean = mean)) # 加...就可以了

pmap(mtc, .f = ~ disp*hp*drat) #不行，不识别公式里的变量
pmap(mtc[3:5], .f = ~ disp*hp*drat) #也不行
pmap(mtc[3:5], .f = ~ ..1*..2*..3) #这样可以
pmap(mtc, .f = function(disp,hp,drat) disp*hp*drat) #不行
pmap(mtc, .f = function(disp,hp,drat,...) disp*hp*drat) #加入...,这样可以
pmap(mtc[3:5], .f = function(disp,hp,drat) disp*hp*drat) #或限定列


