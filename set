#字符处理函数

str <- c('abcdeABc89339', '美丽的长城', '2ab美丽9180aBcfajdsaf', 'abcde', 'ABcDE'); str
nchar(str) #字符数量
substr(x = str,start = 2, stop = 4) #提取子串
substr(x = str,start = 2, stop = 10) 
substr(str, 2, 4) <- '888' #替换功能(不需要再对str赋值)
str

grep(pattern = 'ab', x = str) #寻找与定位匹配模式或字符串的位置
grep(pattern = 'ab', x = str, fixed = F) #查找包含ab的，仅小写
grep(pattern = 'Ab', x = str, fixed = F,ignore.case = T) #ignore.case = T在 fixed = F情形下有效，此时就不会限制字母大小写的具体形式
grep(pattern = '^a', x = str, fixed = F) #查找以a开头的
grep(pattern = 'e$', x = str, fixed = F) #查找以e结尾的
grep(pattern = 'e$', x = str, fixed = F,ignore.case = T)
grep(pattern = 'e$', x = str, fixed = F,ignore.case = T,invert = T) #反取，筛选出满足条件以外的词组
grepl(pattern = 'e$', x = str, fixed = F,ignore.case = T) #用逻辑值表示是否符合条件
str[grepl(pattern = 'e$', x = str, fixed = F,ignore.case = T)] #提取满足逻辑条件的字符串
str[!grepl(pattern = 'e$', x = str, fixed = F,ignore.case = T)] ##反取（前面加了感叹号）
setdiff(str,str[grepl(pattern = 'e$', x = str, fixed = F,ignore.case = T)])

sub(pattern = 'abc', replacement = 'ABC', x = str, fixed = T) #搜索并替换，但是注意需要赋值操作后才能更新变量，这点与substr有别
sub(pattern = 'abc', replacement = 'ABC', x = str, fixed = F,ignore.case = T) #只替换每一字符串第一个匹配的地方
gsub(pattern = 'abc', replacement = 'ABC', x = str, fixed = F,ignore.case = T) #匹配所有
str
str <- sub(pattern = 'abc', replacement = 'ABC', x = str, fixed = T);str

strsplit(x = str, split = "",fixed = T) #分割字符向量，生成列表
strsplit(x = str, split = 'b',fixed = T) #从b的位置分开并删除b
unlist(strsplit(x = str, split = 'b',fixed = T)) #消除列表结构，转化成向量形式

