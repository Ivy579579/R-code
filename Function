mode <- function(x) {
  tb_sp <- table(x)
  if(sum(tb_sp == max(tb_sp)) == 1){
    if(is.character(x)){
      names(which.max(tb_sp))
    }else
      as.numeric(names(which.max(tb_sp)))
  }else
    message('There is no unique mode.')
}

