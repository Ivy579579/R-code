### 拓展：因子的处理函数
library(forcats)

fct_c(factor(1:3), factor(c(5:7,3:6))) #合并因子
## 改变顺序
f <- factor(c("d","a", "c", "b","b","a", "d","a","a","d"), 
            levels = c("b", "c", "d", "a"))
f
fct_relevel(f) #按levels顺序
fct_relevel(f,'a') #置前
fct_relevel(f, "b", "a") #置前
fct_relevel(f, "d", after = 1) #指定位置
fct_relevel(f, "d","a", after = Inf) #最后
fct_relevel(f, rev) #用函数，无参数名
fct_relevel(f, sort) #字母顺序
fct_relevel(f, sample) #随机

fct_count(f)
table(f) #类似
fct_count(f,sort = T, prop = T)#统计频率、占比及排序

fct_inorder(f) #按水平值出现的先后顺序，与fct_relevel(f)不同
fct_infreq(f) #按频率从高到底排
fct_rev(f) #反转水平，与fct_relevel(f, rev)同
fct_reorder(.f = f,.x = f,.fun = length) #与fct_rev(fct_infreq(f))同
fct_reorder(.f = f,.x = f,.fun = length, .desc = T) #默认升序，desc = T降序

fct_reorder(.f = f,.x = 10:1,.fun = mean, .desc = T) #可以根据其他量的计算调整因子
  ##验证with(data.frame(f = f, x = 10:1),by(x,f,mean))

fct_recode(f, notab = 'c')
fct_recode(f, 'not&ab' = 'c') #有特殊字符要用单引号或双引号
fct_recode(f, "not&'ab" = 'c') #若有单引号，要用双引号
fct_recode(f, 'nota&b' = 'c', 'nota&b' = 'd') 
fct_collapse(f, 
             a_b = c('a','b'),
             notabc = c('d'),
             other = 'c') #折叠到手动定义的组里

## 频数较小的进行合并
fct_lump_n(f,n = 2) #留出n个，其余都折叠，可用other_level = '其他'指定名称
fct_lump_prop(f, prop = 0.2) #低于的比例折叠，等于也折叠
fct_lump_min(f, min = 2) #低于的数量折叠，等于不折叠
fct_lump_lowfreq(f) #自动选择

